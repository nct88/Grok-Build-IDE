; Script generated by Inno Setup Script Wizard for Grok Build IDE
#define MyAppName "Grok Build IDE"
#ifndef MyAppVersion
#define MyAppVersion "1.0.6"
#endif
#define MyAppPublisher "Local Grok"
#define MyAppExeName "Grok Build IDE.exe"

[Setup]
AppId={{9F5B2F1C-4B7E-4E6E-9C21-8D9A3B5C7D1E}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
AppPublisher={#MyAppPublisher}
AppPublisherURL=https://github.com/microsoft/vscode
AppSupportURL=https://github.com/microsoft/vscode
AppUpdatesURL=https://github.com/microsoft/vscode
DefaultDirName={localappdata}\Programs\Grok Build IDE
DisableDirPage=no
DefaultGroupName={#MyAppName}
OutputDir=..\..\..\.build\release-candidates\{#MyAppVersion}\inno-installer
OutputBaseFilename=Grok-Build-IDE-Setup-{#MyAppVersion}
SetupIconFile=..\..\..\resources\win32\code.ico
UninstallDisplayIcon={app}\{#MyAppExeName}
Compression=lzma2/max
SolidCompression=yes
WizardStyle=modern
PrivilegesRequired=lowest
PrivilegesRequiredOverridesAllowed=commandline dialog

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked
Name: "contextmenu"; Description: "Add ""Open with Grok Build IDE"" to Windows Explorer context menu"; GroupDescription: "Other options:"

[Files]
Source: "{#PayloadSourceDir}\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs

[Icons]
Name: "{group}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"
Name: "{group}\{cm:UninstallProgram,{#MyAppName}}"; Filename: "{uninstallexe}"
Name: "{autodesktop}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; Tasks: desktopicon

[Registry]
; Open with Grok Build IDE context menu for files
Root: HKCU; Subkey: "Software\Classes\*\shell\GrokBuildIDE"; ValueType: string; ValueData: "Open with Grok Build IDE"; Flags: uninsdeletekey; Tasks: contextmenu
Root: HKCU; Subkey: "Software\Classes\*\shell\GrokBuildIDE"; ValueType: string; ValueName: "Icon"; ValueData: """{app}\{#MyAppExeName}"""; Flags: uninsdeletekey; Tasks: contextmenu
Root: HKCU; Subkey: "Software\Classes\*\shell\GrokBuildIDE\command"; ValueType: string; ValueData: """{app}\{#MyAppExeName}"" ""%1"""; Flags: uninsdeletekey; Tasks: contextmenu

; Open with Grok Build IDE context menu for directories
Root: HKCU; Subkey: "Software\Classes\Directory\shell\GrokBuildIDE"; ValueType: string; ValueData: "Open with Grok Build IDE"; Flags: uninsdeletekey; Tasks: contextmenu
Root: HKCU; Subkey: "Software\Classes\Directory\shell\GrokBuildIDE"; ValueType: string; ValueName: "Icon"; ValueData: """{app}\{#MyAppExeName}"""; Flags: uninsdeletekey; Tasks: contextmenu
Root: HKCU; Subkey: "Software\Classes\Directory\shell\GrokBuildIDE\command"; ValueType: string; ValueData: """{app}\{#MyAppExeName}"" ""%1"""; Flags: uninsdeletekey; Tasks: contextmenu

[Run]
Filename: "{app}\{#MyAppExeName}"; Description: "{cm:LaunchProgram,{#StringChange(MyAppName, '&', '&&')}}"; Flags: nowait postinstall skipifsilent
