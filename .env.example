# xAI / Grok API credentials (from https://console.x.ai)
# Copy this file to `.env` and fill in your key. Never commit `.env`.

# Official variable used by Grok CLI (takes precedence over browser login)
XAI_API_KEY=xai-your-key-here

# Optional: override Grok home directory (default: %USERPROFILE%\.grok)
# GROK_HOME=

# Optional: sandbox profile for agent tools
# GROK_SANDBOX=workspace
